#!/bin/sh
# SPDX-FileCopyrightText: 2026 Massimo Antonini
# SPDX-License-Identifier: MPL-2.0
#
# Starts Mosaikit. The Java code of new or updated plugins is loaded first: the kernel is rebuilt
# only when the set of plugin JARs changed (MK-011, ADR-0004). If the kernel does not start with
# the new JARs, they are rolled back and the kernel starts again with the previous plugins. In the
# portable distribution (MK-016) the bundled PostgreSQL is started before the kernel and stopped
# after it.
#
#   ./mosaikit [start]   prepare and start the kernel (default)
#   ./mosaikit build     prepare only, while building a container image
#
# Settings go in config/application.properties or in environment variables (QUARKUS_*, MOSAIKIT_*).
# JAVA_OPTS adds JVM options. The Java runtime in bin/java/ is used when present, then JAVA_HOME.
set -eu

# In Git Bash, MSYS or Cygwin on Windows the JVM is a Windows program: it needs Windows paths
# (C:/...) and ";" between class path entries.
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*)
    MOSAIKIT_HOME=$(cd "$(dirname "$0")" && pwd -W)
    SEPARATOR=";"
    ;;
  *)
    MOSAIKIT_HOME=$(cd "$(dirname "$0")" && pwd -P)
    SEPARATOR=":"
    ;;
esac
if [ -x "$MOSAIKIT_HOME/bin/java/bin/java" ]; then
  JAVA="$MOSAIKIT_HOME/bin/java/bin/java"
elif [ -n "${JAVA_HOME:-}" ]; then
  JAVA="$JAVA_HOME/bin/java"
else
  JAVA=java
fi

COMMAND=${1:-start}
case "$COMMAND" in
  start | build) ;;
  *)
    echo "usage: $0 [start|build]" >&2
    exit 2
    ;;
esac

cd "$MOSAIKIT_HOME"
KERNEL="$MOSAIKIT_HOME/bin/kernel"
PENDING="$KERNEL/providers/mosaikit-pending.txt"
DATABASE_CONFIG="$MOSAIKIT_HOME/config/database.properties"

launcher() {
  # The launcher is part of the kernel: it runs with the class path of the kernel.
  "$JAVA" -cp "bin/kernel/app/*${SEPARATOR}bin/kernel/lib/main/*" dev.mosaikit.launcher.Launcher "$@" "$MOSAIKIT_HOME"
}

kernel() {
  set --
  if [ -f "$DATABASE_CONFIG" ]; then
    # A location is a URI: file:///C:/... on Windows, file:///opt/... elsewhere.
    CONFIG_URI=$(printf '%s' "$DATABASE_CONFIG" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's#^/##')
    set -- "-Dquarkus.config.locations=file:///$CONFIG_URI"
  fi
  # shellcheck disable=SC2086 # JAVA_OPTS holds several options
  "$JAVA" ${JAVA_OPTS:-} "$@" \
    -Dmosaikit.plugins.directory="$MOSAIKIT_HOME/plugins" \
    -Dmosaikit.plugins.providers-directory="$KERNEL/providers" \
    -Dmosaikit.plugins.packages-directory="$KERNEL/plugin-packages" \
    -jar "$KERNEL/quarkus-run.jar" &
  KERNEL_PID=$!
  trap 'kill -TERM "$KERNEL_PID" 2>/dev/null' TERM INT
  STATUS=0
  wait "$KERNEL_PID" || STATUS=$?
  # wait returns early when a signal is trapped: wait for the kernel to stop.
  while kill -0 "$KERNEL_PID" 2>/dev/null; do
    wait "$KERNEL_PID" || STATUS=$?
  done
  trap - TERM INT
  return "$STATUS"
}

if [ "$COMMAND" = build ]; then
  launcher build
  exit $?
fi

launcher prepare
launcher database start
trap 'launcher database stop' EXIT
STATUS=0
kernel || STATUS=$?
if [ "$STATUS" -ne 0 ] && [ -f "$PENDING" ]; then
  echo "Mosaikit: the kernel stopped (exit code $STATUS) before starting with the new plugin JARs." >&2
  launcher prepare
  STATUS=0
  kernel || STATUS=$?
fi
exit "$STATUS"
