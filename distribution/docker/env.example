#
# Copy to .env and change every password before the first start.
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me-too
KEYCLOAK_ADMIN_PASSWORD=change-me-as-well
MOSAIKIT_ADMIN_PASSWORD=change-me-now
# Secret of the Keycloak client with which Mosaikit creates the realms of organizations.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-this-secret
# Public URL of Keycloak, as browsers reach it.
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Signed plugin packages: "optional" (default) or "required".
MOSAIKIT_PLUGINS_SIGNATURES=optional
