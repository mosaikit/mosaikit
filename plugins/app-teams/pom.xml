<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.mosaikit</groupId>
        <artifactId>mosaikit-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>io.github.mosaikit.apps</groupId>
    <artifactId>mosaikit-app-teams</artifactId>
    <packaging>pom</packaging>
    <name>Mosaikit :: Apps :: Teams</name>
    <description>Teams with channels and posts, a plugin without a backend: only packaged as a zip.</description>

    <properties>
        <plugin.package.name>app-teams</plugin.package.name>
        <!-- SonarQube: what this module contributes to the analysis (the root pom.xml sets the default). -->
        <sonar.sources>pom.xml,manifest.yaml,web</sonar.sources>
        <sonar.tests></sonar.tests>
        <!-- A frontend without a build: its end-to-end tests (e2e/tests/21-channels) check it, not the coverage. -->
        <sonar.coverage.exclusions>**/*</sonar.coverage.exclusions>
    </properties>

    <build>
        <plugins>
            <plugin>
                <!-- target/app-teams-<version>.zip, the plugin to install. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
