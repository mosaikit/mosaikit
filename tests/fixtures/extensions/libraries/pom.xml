<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.mosaikit</groupId>
        <artifactId>mosaikit-extension-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../../sdk/extension-parent/pom.xml</relativePath>
    </parent>
    <groupId>io.github.mosaikit.fixtures</groupId>
    <artifactId>mosaikit-fixture-libraries</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Mosaikit :: Fixtures :: Libraries</name>
    <description>Sample Java extension that brings its own libraries (MK-131).</description>
    <properties>
        <extension.package.name>fixture-libraries</extension.package.name>
        <!-- SonarQube: a fixture runs in a separate kernel in the installation tests, whose coverage
             is not collected. -->
        <sonar.coverage.exclusions>**/*</sonar.coverage.exclusions>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.mosaikit</groupId>
            <artifactId>mosaikit-kernel-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- A library the kernel does not provide: it goes into lib/ with Commons Lang, which it uses. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
        </dependency>
        <!-- A library the kernel provides, declared without a scope: the parent POM makes it provided,
             so it stays out of the package. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
