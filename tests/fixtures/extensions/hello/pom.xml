<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.mosaikit</groupId>
        <artifactId>mosaikit-extension-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../../sdk/extension-parent/pom.xml</relativePath>
    </parent>
    <groupId>io.github.mosaikit.fixtures</groupId>
    <artifactId>mosaikit-fixture-hello</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Mosaikit :: Fixtures :: Hello</name>
    <description>Sample frontend extension, without Java code: only packaged as a zip.</description>
    <properties>
        <extension.package.name>fixture-hello</extension.package.name>
        <!-- SonarQube: a fixture runs in a separate kernel in the installation tests, whose coverage
             is not collected. -->
        <sonar.coverage.exclusions>**/*</sonar.coverage.exclusions>
    </properties>
</project>
