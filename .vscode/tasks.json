{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mosaikit: dev (hot reload, http://127.0.0.1:5173)",
      "type": "shell",
      "command": "cargo xtask dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "mosaikit: db up",
      "type": "shell",
      "command": "cargo xtask db up",
      "problemMatcher": []
    },
    {
      "label": "mosaikit: test",
      "type": "shell",
      "command": "cargo xtask test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "mosaikit: e2e (browser)",
      "type": "shell",
      "command": "cargo xtask e2e",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "mosaikit: ci",
      "type": "shell",
      "command": "cargo xtask ci",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "mosaikit: server build",
      "type": "shell",
      "command": "cargo build -p mosaikit-server",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "mosaikit: new plugin",
      "type": "shell",
      "command": "cargo xtask plugin new ${input:pluginName}",
      "problemMatcher": []
    },
    {
      "label": "mosaikit: release desktop",
      "type": "shell",
      "command": "cargo xtask release desktop",
      "problemMatcher": []
    },
    {
      "label": "mosaikit: release docker",
      "type": "shell",
      "command": "cargo xtask release docker",
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "pluginName", "type": "promptString", "description": "Name of the plugin (lower case and '-')" }
  ]
}
