{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaikit.github.io/schemas/requirement/0.1.json",
  "title": "Mosaikit requirement",
  "type": "object",
  "required": ["id", "title", "area", "priority", "status", "description", "acceptance"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MK-\\d{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "area": {
      "enum": [
        "kernel",
        "extensions",
        "shell",
        "sdk",
        "security",
        "distribution",
        "marketplace",
        "ai"
      ]
    },
    "priority": {
      "enum": ["P1", "P2", "P3"]
    },
    "status": {
      "enum": ["planned", "in-progress", "done"]
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "depends": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MK-\\d{3}$"
      }
    },
    "verified-in": {
      "description": "Repository whose tests verify the requirement, when they are not in this one (ADR-0035), for example mosaikit/app-teams.",
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9.-]+$"
    }
  }
}
