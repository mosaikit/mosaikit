{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaikit.github.io/schemas/extension-manifest/0.1.json",
  "title": "Mosaikit extension manifest",
  "description": "Declares what an extension is, what it needs and what it contributes. The kernel applies the same rules in ExtensionManifests (kernel-api).",
  "type": "object",
  "required": ["id", "version", "name", "kind", "platform"],
  "properties": {
    "id": {
      "description": "Stable reverse-DNS identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "description": "Semantic version of the extension.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "description": "What the extension brings: one value or a list.",
      "oneOf": [
        {
          "$ref": "#/$defs/kind"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kind"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "platform": {
      "description": "Range of kernel versions, for example \">=0.1 <1\".",
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "description": "Required extensions with their accepted versions: installation and start need them (MK-132).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/dottedName"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "optional": {
      "description": "Extensions used when they are installed in an accepted version; never needed to install or start (MK-132). An id is either here or in requires.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/dottedName"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "frontend": {
      "type": "object",
      "required": ["entry"],
      "properties": {
        "entry": {
          "$ref": "#/$defs/relativePath"
        },
        "isolation": {
          "enum": ["module", "iframe"],
          "default": "module"
        },
        "bridge": {
          "description": "What the frontend may do through the shell in an isolated iframe (MK-014).",
          "type": "object",
          "properties": {
            "publishes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/topic"
              },
              "uniqueItems": true
            },
            "subscribes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/topic"
              },
              "uniqueItems": true
            },
            "services": {
              "type": "array",
              "items": {
                "enum": ["api", "data"]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "points": {
          "description": "Extension points the frontend offers to other extensions, which contribute to them (MK-020).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)+$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "description": "Java code of the extension, loaded by the launcher at the next start.",
      "type": "object",
      "required": ["jar", "api"],
      "properties": {
        "jar": {
          "allOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "pattern": "\\.jar$"
            }
          ]
        },
        "api": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,39}$"
        }
      },
      "additionalProperties": false
    },
    "data": {
      "description": "Collections of JSON documents that the extension keeps in the kernel, per organization, without a backend of its own (ADR-0031).",
      "type": "object",
      "required": ["collections"],
      "properties": {
        "collections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^ext_[a-z][a-z0-9_]{0,57}$"
        },
        "migrations": {
          "$ref": "#/$defs/relativePath",
          "default": "db"
        }
      },
      "additionalProperties": false
    },
    "contributes": {
      "description": "Contributions grouped by extension point.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/dottedName"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "i18n": {
              "description": "The text attributes in other languages, by language tag (MK-053), such as { \"it\": { \"title\": \"Catalogo\" } }.",
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(-[A-Z][A-Za-z0-9]{1,7})?$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "description": "Typed actions that an assistant can use with the permissions of the person (MK-015).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "title", "risk", "call"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "risk": {
            "enum": ["read", "write", "execute"]
          },
          "input": {
            "description": "JSON Schema of the arguments, with type object.",
            "type": "object",
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "call": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "method": {
                "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "permissions": {
      "description": "Permissions of the extension, off until the administrators of an organization grant them through profiles, groups or personal exceptions (MK-056).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "title"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "i18n": {
            "$ref": "#/$defs/i18n",
            "additionalProperties": {
              "propertyNames": {
                "enum": ["title", "description"]
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "measures": {
      "description": "What the extension meters for each organization: platform administrators set a limit per organization, the extension asks the kernel before an action, and the administrators of the organization see the consumption (MK-076). In the kernel a measure is <extension>/<id>.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "unit", "kind"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "kind": {
            "description": "counter: what is used in a calendar month (UTC); gauge: what is kept now.",
            "enum": ["counter", "gauge"]
          },
          "i18n": {
            "$ref": "#/$defs/i18n",
            "additionalProperties": {
              "propertyNames": {
                "enum": ["label"]
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "description": "Types of the resources the extension registers with the kernel (MK-054) and shares at the levels it declares (MK-055).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title", "levels"],
        "dependentSchemas": {
          "linkLevel": {
            "required": ["subjects"],
            "properties": {
              "subjects": {
                "contains": { "const": "link" }
              }
            }
          }
        },
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "levels": {
            "description": "Sharing levels from the lowest to the highest; each includes those before it.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "title"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,31}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "edits": {
                  "description": "Whether the level lets people change the resource; never given to a link or to the public, and every level after it edits too.",
                  "type": "boolean"
                },
                "i18n": {
                  "$ref": "#/$defs/i18n",
                  "additionalProperties": {
                    "propertyNames": {
                      "enum": ["title"]
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "subjects": {
            "description": "Who a resource of the type may be shared with; person, group and organization when left out.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["person", "group", "organization", "link", "public"]
            }
          },
          "linkLevel": {
            "description": "The highest level a link may give, a level that does not edit; the lowest level when left out. The public always gets the lowest level.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "i18n": {
            "$ref": "#/$defs/i18n",
            "additionalProperties": {
              "propertyNames": {
                "enum": ["title"]
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "theme": {
      "description": "The theme of an extension of kind theme (MK-028): colors of the light and dark schemes; what is left out comes from the default theme.",
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "font": {
          "type": "string",
          "maxLength": 200
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "product": {
          "description": "The name of the product, shown in place of Mosaikit when this is the theme of the installation (MK-052).",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "logo": {
          "description": "The logo of the product, SVG or PNG files of the extension, shown in place of the one of Mosaikit when this is the theme of the installation (MK-052).",
          "type": "object",
          "required": ["light"],
          "additionalProperties": false,
          "properties": {
            "light": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.(svg|png)$"
            },
            "dark": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.(svg|png)$"
            }
          }
        },
        "light": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brand": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "line": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "danger": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "success": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "warning": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "focus": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brand": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "line": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "danger": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "success": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "warning": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "focus": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "kind": {
      "enum": ["app", "extension", "service", "theme", "locale", "auth"]
    },
    "dottedName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)+$"
    },
    "topic": {
      "description": "Dotted event topic, or a prefix ending with .*",
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)*\\.([a-z][a-zA-Z0-9-]*|\\*)$"
    },
    "i18n": {
      "description": "Text attributes in other languages, by language tag (MK-053), such as { \"it\": { \"title\": \"Cruscotto\" } }.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Z][A-Za-z0-9]{1,7})?$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|\\\\|:|(^|/)\\.\\.(/|$))"
      }
    }
  }
}
