{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaikit.github.io/schemas/extension-manifest/0.1.json",
  "title": "Mosaikit extension manifest",
  "description": "Declares what an extension is, what it needs and what it contributes. The kernel applies the same rules in ExtensionManifests (kernel-api).",
  "type": "object",
  "required": ["id", "version", "name", "kind", "platform"],
  "properties": {
    "id": {
      "description": "Stable reverse-DNS identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "description": "Semantic version of the extension.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "description": "What the extension brings: one value or a list.",
      "oneOf": [
        {
          "$ref": "#/$defs/kind"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kind"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "platform": {
      "description": "Range of kernel versions, for example \">=0.1 <1\".",
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "description": "Required extensions with their accepted versions.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/dottedName"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "frontend": {
      "type": "object",
      "required": ["entry"],
      "properties": {
        "entry": {
          "$ref": "#/$defs/relativePath"
        },
        "isolation": {
          "enum": ["module", "iframe"],
          "default": "module"
        },
        "bridge": {
          "description": "What the frontend may do through the shell in an isolated iframe (MK-014).",
          "type": "object",
          "properties": {
            "publishes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/topic"
              },
              "uniqueItems": true
            },
            "subscribes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/topic"
              },
              "uniqueItems": true
            },
            "services": {
              "type": "array",
              "items": {
                "enum": ["api", "data"]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "points": {
          "description": "Extension points the frontend offers to other extensions, which contribute to them (MK-020).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)+$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "description": "Java code of the extension, loaded by the launcher at the next start.",
      "type": "object",
      "required": ["jar", "api"],
      "properties": {
        "jar": {
          "allOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "pattern": "\\.jar$"
            }
          ]
        },
        "api": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,39}$"
        }
      },
      "additionalProperties": false
    },
    "data": {
      "description": "Collections of JSON documents that the extension keeps in the kernel, per organization, without a backend of its own (ADR-0031).",
      "type": "object",
      "required": ["collections"],
      "properties": {
        "collections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^ext_[a-z][a-z0-9_]{0,57}$"
        },
        "migrations": {
          "$ref": "#/$defs/relativePath",
          "default": "db"
        }
      },
      "additionalProperties": false
    },
    "contributes": {
      "description": "Contributions grouped by extension point.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/dottedName"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "actions": {
      "description": "Typed actions that an assistant can use with the permissions of the person (MK-015).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "title", "risk", "call"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "risk": {
            "enum": ["read", "write", "execute"]
          },
          "input": {
            "description": "JSON Schema of the arguments, with type object.",
            "type": "object",
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "call": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "method": {
                "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "theme": {
      "description": "The theme of an extension of kind theme (MK-028): colors of the light and dark schemes; what is left out comes from the default theme.",
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "font": {
          "type": "string",
          "maxLength": 200
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "light": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brand": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "line": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "danger": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "success": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "warning": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "focus": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brand": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "line": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "danger": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "success": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "warning": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "focus": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "kind": {
      "enum": ["app", "extension", "service", "theme", "locale", "auth"]
    },
    "dottedName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)+$"
    },
    "topic": {
      "description": "Dotted event topic, or a prefix ending with .*",
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)*\\.([a-z][a-zA-Z0-9-]*|\\*)$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|\\\\|:|(^|/)\\.\\.(/|$))"
      }
    }
  }
}
