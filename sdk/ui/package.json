{
  "name": "@mosaikit/ui",
  "version": "0.1.0-SNAPSHOT",
  "description": "User interface kit of Mosaikit: Fluent UI web components with the themes of the shell.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosaikit/mosaikit.git",
    "directory": "sdk/ui"
  },
  "author": "Massimo Antonini",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./fonts.css": "./src/fonts.css"
  },
  "files": [
    "dist",
    "src/fonts.css"
  ],
  "sideEffects": [
    "./dist/components.js",
    "./dist/empty-state.js",
    "./dist/list-page.js",
    "./dist/split-pane.js",
    "./src/components.ts",
    "./src/empty-state.ts",
    "./src/list-page.ts",
    "./src/split-pane.ts",
    "./src/fonts.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@fluentui/web-components": "3.1.3",
    "@fontsource/titillium-web": "5.3.0",
    "@microsoft/fast-element": "3.0.4"
  }
}
