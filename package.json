{
  "name": "mosaikit-workspace",
  "private": true,
  "description": "UI of Mosaikit: host and plugin-api (the plugins are in ../mosaikit-plugins)",
  "workspaces": [
    "ui/plugin-api",
    "ui/plugin-testing",
    "ui/host",
    "tests/e2e",
    "tests/manual"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint ui tests --deny-warnings"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "happy-dom": "^21.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
