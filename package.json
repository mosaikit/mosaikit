{
  "name": "mosaikit-workspace",
  "private": true,
  "description": "Frontend of Mosaikit as npm workspaces: extension SDK and kernel UI. The Maven build runs it.",
  "license": "MPL-2.0",
  "author": "Massimo Antonini",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "sdk/js",
    "sdk/ui",
    "sdk/create-extension",
    "sdk/testing",
    "src/web"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p docs/requirements && tsc -p docs/test && tsc -p sdk/java && tsc -p tests/e2e && tsc -p build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "verify": "npm run check && npm run build",
    "e2e": "node tests/e2e/run.ts",
    "dev": "node build/dev.ts",
    "check:fast": "npm run lint && npm run typecheck && vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true
  }
}
