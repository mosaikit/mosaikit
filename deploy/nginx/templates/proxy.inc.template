# Shared proxy settings, included by the server blocks. The Host header must reach the app
# unchanged (the app tells the app origin from the plugin origins by it).
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
# websockets and server-sent events
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
# long requests: imports, exports, backups, large uploads and downloads, streams
proxy_connect_timeout 10s;
proxy_send_timeout 3600s;
proxy_read_timeout 3600s;
send_timeout 3600s;
proxy_request_buffering off;
proxy_buffering off;
