# Passwords of {{name}}: CHANGE THEM before `kubectl apply -k .` and do not commit them.
# The first two are used by the first initialization of the database: changing them later
# requires updating them in PostgreSQL too (ALTER ROLE).

# PostgreSQL superuser
POSTGRES_PASSWORD=cambia-questa-password
# application role mosaikit_app
MOSAIKIT_DB_PASSWORD=cambia-anche-questa
# initial password of admin (tenant system), used only at the first start
MOSAIKIT_ADMIN_PASSWORD=cambiami-subito
