# Password di {{name}}: CAMBIALE prima di `kubectl apply -k .` e non committarle.
# Le prime due servono alla prima inizializzazione del database: cambiarle dopo
# richiede di aggiornarle anche in PostgreSQL (ALTER ROLE).

# superutente di PostgreSQL
POSTGRES_PASSWORD=cambia-questa-password
# ruolo applicativo mosaikit_app
MOSAIKIT_DB_PASSWORD=cambia-anche-questa
# password iniziale di admin (tenant system), usata solo al primo avvio
MOSAIKIT_ADMIN_PASSWORD=cambiami-subito
