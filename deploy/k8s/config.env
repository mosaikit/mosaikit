# Configuration of {{name}} (not secret). Every property of mosaikit.toml can be
# set with the matching MOSAIKIT_* variable (see mosaikit.example.toml).

# public address of the app (hostname of the Ingress), also with a base path
MOSAIKIT_URL=https://{{id}}.example.com
# plugin UIs, files and public links: second hostname of the Ingress
MOSAIKIT_PLUGIN_URL=https://plugins.{{id}}.example.com
# behind the Ingress: the address of the client arrives in X-Forwarded-For
MOSAIKIT_TRUST_PROXY=true
# log level (stdout of the container)
MOSAIKIT_LOG=info,sqlx=warn
