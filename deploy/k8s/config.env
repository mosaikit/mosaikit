# Configurazione di {{name}} (non segreta). Ogni proprieta' di mosaikit.toml si puo'
# impostare con la variabile MOSAIKIT_* corrispondente (vedi mosaikit.example.toml).

# indirizzo pubblico dell'app (hostname dell'Ingress), anche con percorso base
MOSAIKIT_URL=https://{{id}}.esempio.it
# UI dei plugin, file e link pubblici: secondo hostname dell'Ingress
MOSAIKIT_PLUGIN_URL=https://plugins.{{id}}.esempio.it
# dietro l'Ingress: l'indirizzo del client arriva in X-Forwarded-For
MOSAIKIT_TRUST_PROXY=true
# livello dei log (stdout del container)
MOSAIKIT_LOG=info,sqlx=warn
